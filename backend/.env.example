# Variables d'environnement du backend SGS — exemple de configuration.
# Copier ce fichier vers .env (jamais commité, voir .gitignore) et renseigner
# les valeurs. Chaque variable peut aussi être passée directement à la JVM
# (export, systemd, Docker -e, IDE run configuration, etc.).

# ── Base de données ──────────────────────────────────────────────
# URL JDBC PostgreSQL (défaut : jdbc:postgresql://localhost:5432/stock_db)
DB_URL=jdbc:postgresql://localhost:5432/stock_db
DB_USERNAME=postgres
# REQUIS — aucun mot de passe par défaut
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────────
# REQUIS — clé de signature HMAC-SHA256 encodée en Base64 (>= 32 octets).
# Générer une clé :  openssl rand -base64 48
JWT_SECRET=
# Durée de vie de l'access token en millisecondes (défaut : 15 min)
JWT_EXPIRATION_MS=900000
# Durée de vie du refresh token en millisecondes (défaut : 7 jours)
# Presenté à POST /api/auth/refresh pour renouveler l'access token sans re-login.
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Admin de bootstrap (premier démarrage) ───────────────────────
# REQUIS — mot de passe du compte admin créé si la base est vide.
# Générer un mot de passe fort :  openssl rand -base64 24
ADMIN_PASSWORD=
# Optionnels
ADMIN_LOGIN=admin@sgs.local
ADMIN_ROLE=ADMIN

# ── CORS ─────────────────────────────────────────────────────────
# Origines autorisées à appeler l'API (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173

# ── Rate limiting du login (anti brute force) ────────────────────
# Optionnels — défauts : 5 échecs max, fenêtre de 300 secondes (5 min).
# Après N échecs par IP dans la fenêtre, 429 (Retry-After) jusqu'à expiration.
#RATE_LIMIT_LOGIN_MAX_FAILURES=5
#RATE_LIMIT_LOGIN_WINDOW_SECONDS=300

# ── Emails (SMTP) ────────────────────────────────────────────────
# Vides par défaut — sans configuration, les envois échouent silencieusement.
MAIL_USERNAME=
MAIL_PASSWORD=
